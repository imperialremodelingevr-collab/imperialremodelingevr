# Imperial Remodeling EVR — Variables de entorno del agente
# Copia este archivo como .env:  cp .env.agent.example .env
# NUNCA subas el archivo .env a GitHub

# ── Anthropic ──────────────────────────────────────────────
# Obtener en: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...
# claude-sonnet-5-5 (default) | claude-opus-5-5 | claude-haiku-5-5
ANTHROPIC_MODEL=claude-sonnet-5-5
# Esfuerzo: low (rápido y barato) | medium | high
ANTHROPIC_EFFORT=low

# ── Proveedor de WhatsApp ──────────────────────────────────
# Opciones: zernio | meta
WHATSAPP_PROVIDER=zernio

# ── Zernio (si WHATSAPP_PROVIDER=zernio) ───────────────────
# Crear cuenta en: https://zernio.com  — 2 cuentas gratis, sin tarjeta
# API Key: Settings → API Keys (empieza con "sk_")
ZERNIO_API_KEY=sk_...
# Webhook Secret: texto secreto que tú inventas (cualquier palabra larga)
ZERNIO_WEBHOOK_SECRET=imperial-remodeling-secret-2026
# Opcional: tu account ID de Zernio (para el chequeo de conexión al arrancar)
ZERNIO_ACCOUNT_ID=

# ── Meta Cloud API (si WHATSAPP_PROVIDER=meta) ─────────────
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_VERIFY_TOKEN=imperial-remodeling-verify
# META_APP_SECRET=
# META_API_VERSION=v25.0

# ── Servidor ───────────────────────────────────────────────
PORT=8000
ENVIRONMENT=development

# ── Base de datos ──────────────────────────────────────────
# Local (SQLite — se borra con cada redespliegue):
DATABASE_URL=sqlite+aiosqlite:///./agentkit.db
# Producción (PostgreSQL en Railway):
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# ── API de administración (opcional) ──────────────────────
# Si la configuras, los endpoints /admin/* la requieren en el header X-API-Key
# REPORT_API_KEY=tu-clave-secreta-aqui
